# Copy to keystore.properties (gitignored) and fill in YOUR OWN values. Never commit the real file.
# Create a keystore with:
#   keytool -genkeypair -v -keystore my-release.jks -alias beacon -keyalg RSA -keysize 2048 -validity 10000
storeFile=path/to/my-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=beacon
keyPassword=YOUR_KEY_PASSWORD
